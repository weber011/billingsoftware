# LensArt - Optical Retail Management System

## Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lensart?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-string-here"

# File Storage (configure for production)
# STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Email (configure for production)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# App Configuration
APP_TIMEZONE="Asia/Kolkata"
APP_CURRENCY="INR"
APP_DATE_FORMAT="DD/MM/YYYY"
